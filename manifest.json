{
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "copy-md": {
      "description": "复制为 Markdown 格式",
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      }
    },
    "copy-merge-add": {
      "description": "加入合并复制",
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      }
    },
    "copy-merge-done": {
      "description": "完成并清空内容",
      "suggested_key": {
        "default": "Alt+Shift+Z",
        "mac": "Alt+Shift+Z"
      }
    },
    "share-joplin": {
      "description": "一键分享至 Joplin (MD 格式)",
      "suggested_key": {
        "default": "Alt+Shift+J",
        "mac": "Alt+Shift+J"
      }
    }
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_end"
    }
  ],
  "description": "我的右键，在Chrome的右键菜单整合了多种搜索引擎、翻译、字典、常用网络工具等常用功能",
  "host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "128": "myright128.png",
    "16": "myright16.png",
    "32": "myright32.png",
    "48": "myright48.png",
    "64": "myright64.png"
  },
  "manifest_version": 3,
  "name": "我的右键 (v1.3.6 MV3)",
  "options_page": "options.html",
  "permissions": [
    "contextMenus",
    "tabs",
    "downloads",
    "downloads.open",
    "notifications",
    "scripting",
    "storage",
    "clipboardWrite",
    "offscreen"
  ],
  "version": "1.3.6"
}